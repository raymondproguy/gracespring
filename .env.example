# GraceSpring API. Copy to /etc/gracespring/api.env on the server, or
# apps/api/.env for local development. Never commit real values. Only
# this file (.env.example with placeholders) is allowed in the repo.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# Postgres: shared database, app user, app schema (docs/DEPLOYMENT.md)
DATABASE_URL=postgres://app:CHANGE_ME@127.0.0.1:5432/gracespring?sslmode=disable&search_path=app
DB_MAX_CONNS=10

# Redis: database 0 for the app, csag uses a different number
REDIS_URL=redis://localhost:6379/0

# Auth: csag on 8081. AUTH_VERIFY_MODE and the rest of the auth settings
# are decided by the token spike in docs/AUTH.md
AUTH_BASE_URL=http://localhost:8081
AUTH_VERIFY_MODE=local
AUTH_JWT_SECRET=
AUTH_JWKS_URL=

# CORS: the web app origin only
ALLOWED_ORIGINS=http://localhost:5173

# Storage: local for v1, R2 planned
STORAGE_DRIVER=local
MEDIA_PATH=./data/media
MEDIA_BASE_URL=http://localhost:8080/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email (app mail)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Web push (v2)
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Errors
SENTRY_DSN=
