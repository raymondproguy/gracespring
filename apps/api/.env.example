# Copy to apps/api/.env and set the password and JWT secret locally.
# Point DATABASE_URL at the same host and database as csag, but use the
# GraceSpring database role and app schema. Local csag currently uses public.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8082
LOG_LEVEL=info
DATABASE_URL="postgres://gracespring_app:CHANGE_ME@127.0.0.1:5432/gracespring?sslmode=disable&search_path=app"
DB_MAX_CONNS=10
REDIS_URL=redis://localhost:6379/0
AUTH_BASE_URL=http://127.0.0.1:8080
AUTH_JWT_SECRET=CHANGE_ME_COPY_FROM_CSAG_JWT_SECRET
CSAG_AUTH_SCHEMA=public
ALLOWED_ORIGINS=http://localhost:5173
STORAGE_DRIVER=local
MEDIA_PATH=./data/media
MEDIA_BASE_URL=http://127.0.0.1:8082/media
